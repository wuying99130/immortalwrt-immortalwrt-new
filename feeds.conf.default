# ImmortalWrt 主源（必须）
src-git iwrt_core https://github.com/immortalwrt/immortalwrt.git

# ImmortalWrt 包源（必须）
src-git iwrt_packages https://github.com/immortalwrt/packages.git

# ImmortalWrt LuCI（必须）
src-git iwrt_luci https://github.com/immortalwrt/luci.git

# OpenWrt 23.05 的 routing / telephony（ImmortalWrt 不提供）
src-git routing https://github.com/openwrt/routing.git;openwrt-23.05
src-git telephony https://github.com/openwrt/telephony.git;openwrt-23.05
