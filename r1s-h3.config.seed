# 1. 目标平台锁定 (第 2 点：14 版单设备锁定方式，禁用 Profile 膨胀)
CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa7=y
CONFIG_TARGET_sunxi_cortexa7_DEVICE_friendlyarm_nanopi-r1s-h3=y

# 2. 镜像生成控制 (第 3 点：输出 img.gz 和 Docker rootfs.tar.gz)
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y

# 3. 简体中文语言界面 (第 1 点：默认简体中文)
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# 4. 板载 LAN 口 USB RTL8152 网卡驱动 (15 版硬件驱动，保持不动)
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y

# 5. AP6212 (BCM43430) SDIO 无线核心驱动与固件 (15 版硬件驱动，保持不动)
CONFIG_PACKAGE_kmod-brcmfmac=y
CONFIG_PACKAGE_brcmfmac-firmware-43430-sdio=y
CONFIG_PACKAGE_cypress-firmware-43430-sdio=y

# 6. 无线协议栈与管理工具 (15 版硬件驱动，保持不动)
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# 7. LuCI 基础界面组件
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
