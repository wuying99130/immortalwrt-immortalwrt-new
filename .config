############################################################
# 顶层 .config 补齐 CONFIG_KERNEL_* 派生项
# 这些项在构建时会从 CONFIG_KERNEL_xxx 转换成 CONFIG_xxx
# 如果缺失，会导致 Restart config
############################################################

# 关闭内核调试，避免交互
CONFIG_KERNEL_DEBUG=n

# KALLSYMS 相关项必须明确，否则构建时会自动询问
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_KALLSYMS_ALL=n
CONFIG_KERNEL_KALLSYMS_UNCOMPRESSED=y
